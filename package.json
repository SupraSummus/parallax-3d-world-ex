{
  "name": "parallax-world",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm wasm && vite",
    "build": "pnpm wasm && vite build",
    "preview": "vite preview",
    "wasm": "cargo build --release --target wasm32-unknown-unknown --manifest-path bake/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && cargo clippy --manifest-path bake/Cargo.toml --all-targets -- -D warnings && cargo fmt --manifest-path bake/Cargo.toml --check",
    "test": "pnpm wasm && cargo test --manifest-path bake/Cargo.toml && vitest run",
    "knip": "knip",
    "knip:production": "knip --production"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "tailwind-merge": "^3.7.0",
    "three": "0.187.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.0"
}
